# Everything here is optional: with no Supabase values the site lists the real built-in looks, and publishing, voting and sign-in stay off.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The site's public address, for canonical links, the sitemap and social cards.
# On Vercel it falls back to the production URL.
NEXT_PUBLIC_SITE_URL=

# Overrides the Download Eclipse.zip link. Empty, it is the official Google Drive file.
NEXT_PUBLIC_DOWNLOAD_URL=

# The community Discord. Each part stays off while its values are empty.
# Weekly look of the week post (with CRON_SECRET, which Vercel's scheduler sends).
CRON_SECRET=
DISCORD_WEBHOOK_URL=
# Moderators' channel, told about each new report.
DISCORD_MOD_WEBHOOK_URL=
# The #wardrobe channel, told about each newly published look.
DISCORD_FEED_WEBHOOK_URL=
# The Eclipse app: its public key checks /api/discord/interactions. DISCORD_APP_ID is
# for tools/register-discord-commands.mjs, run from this machine.
DISCORD_PUBLIC_KEY=
DISCORD_APP_ID=
# The bot in the community server: "Add to Wardrobe" on a #showcase post, and the
# Wardrobe Creator and Look of the Week roles (each role's id turns it on).
DISCORD_GUILD_ID=
DISCORD_BOT_TOKEN=
DISCORD_CREATOR_ROLE_ID=
DISCORD_WEEK_ROLE_ID=
# The database's secret key, for the bot alone (src/lib/data/admin.ts). It skips every
# row rule, so it lives only in the server's environment, never in a NEXT_PUBLIC_ value.
SUPABASE_SECRET_KEY=
